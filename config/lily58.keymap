/*
 * Lily58 ZMK keymap
 * Layers transcribed from ZMK Studio screenshots.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
// ,------------------------------------------------.                    ,------------------------------------------------.
   &kp ESC   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                      &kp N6   &kp N7   &kp N8    &kp N9   &kp N0    &kp BSPC
   &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T                       &kp Y    &kp U    &kp I     &kp O    &kp P     &kp BSLH
   &kp LCTRL &kp A    &kp S    &kp D    &kp F    &kp G                       &kp H    &kp J    &kp K     &kp L    &kp SEMI  &kp SQT
   &kp LSHFT &kp Z    &kp X    &kp C    &kp V    &kp B    &kp INS   &kp DEL  &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH  &mo 1
//                    `------------------------------------------'  `------------------------------------------'
                          &kp UP   &kp DOWN &kp LGUI &kp LSHFT        &kp SPACE &kp RET  &kp LEFT &kp RIGHT
            >;
        };

        layer_1 {
            display-name = "Layer 1";
            bindings = <
// ,------------------------------------------------.                    ,-------------------------------------------------------------.
   &trans    &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                      &kp KP_NUM &trans    &trans    &trans    &kp KP_MINUS    &kp DEL
   &trans    &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                     &trans     &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS     &trans
   &trans    &kp F11  &kp F12  &trans   &trans   &kp MINUS                   &kp EQUAL  &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DIVIDE   &trans
   &trans    &trans   &trans   &trans   &trans   &trans   &kp LBKT  &kp RBKT &trans     &trans    &kp KP_N0 &kp KP_DOT &kp KP_MULTIPLY &trans
//                    `------------------------------------------'  `------------------------------------------'
                          &kp HOME &kp END  &trans   &trans           &trans    &trans   &kp PG_UP &kp PG_DN
            >;
        };

        // Empty layers for ZMK Studio to fill in. Ignored by non-Studio builds.
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
    };
};
