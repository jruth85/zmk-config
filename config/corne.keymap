/*
 * Corne ZMK keymap
 * Converted from crone.vil (Vial). Same layers and layer keys.
 * Layer 3's RGB keys were replaced with Bluetooth/output controls,
 * and a bootloader key was added to each half.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &gresc     &kp Q      &kp W      &kp E      &kp R      &kp T          &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
   &kp LCTRL  &kp A      &kp S      &kp D      &kp F      &kp G          &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
   &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &mo 1
//                                  `--------------------------------'  `--------------------------------'
                                    &kp LGUI   &mo 2      &kp RSHFT      &kp SPACE  &kp RET    &kp RALT
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &kp TAB    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp DEL
   &kp LCTRL  &none      &kp UP     &none      &none      &kp MINUS      &kp PG_UP  &kp HOME   &kp INS    &kp LBKT   &kp UP     &kp BSLH
   &kp LSHFT  &kp LEFT   &kp DOWN   &kp RIGHT  &none      &kp EQUAL      &kp PG_DN  &kp END    &kp LS(INS) &kp LEFT  &kp RIGHT  &kp RIGHT
//                                  `--------------------------------'  `--------------------------------'
                                    &kp LGUI   &mo 3      &trans         &kp SPACE  &trans     &kp RALT
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &kp ESC    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5         &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp BSPC
   &kp LCTRL  &none      &none      &none      &none      &kp F11        &kp F12    &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
   &kp LSHFT  &none      &none      &none      &none      &none          &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
//                                  `--------------------------------'  `--------------------------------'
                                    &kp LGUI   &trans     &mo 3          &kp RET    &trans     &kp RALT
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &bootloader &none     &none      &none      &none      &none          &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS &kp KP_DIVIDE &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none &none         &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS  &kp KP_MULTIPLY &none
   &out OUT_TOG &none    &none      &none      &none      &none          &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT   &kp COLON  &bootloader
//                                  `--------------------------------'  `--------------------------------'
                                    &kp LGUI   &trans     &kp SPACE      &kp SPACE  &kp KP_N0  &kp KP_ENTER
            >;
        };

        // Empty layers for ZMK Studio to fill in. Ignored by non-Studio builds.
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
    };
};
