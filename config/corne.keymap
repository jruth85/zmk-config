/*
 * Corne ZMK keymap
 * Matches crone.vil. Layer 3's RGB keys are Bluetooth/output controls here,
 * and each half has a bootloader key on layer 3.
 *
 * Sticky layers (&sl) act like &mo when held, and like one-shot layers when tapped.
 * Tap the Fn thumb key once  -> next key comes from Fn (layer 2).
 * Tap it twice               -> next key comes from Shifted Numbers (layer 4).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &gresc     &kp Q      &kp W      &kp E      &kp R      &kp T          &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
   &kp TAB  &kp A      &kp S      &kp D      &kp F      &kp G          &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
   &kp LCTRL  &kp Z      &kp X      &kp C      &kp V      &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &sl 1
//                                  `--------------------------------'  `--------------------------------'
                                    &kp LGUI   &sl 2      &kp RSHFT      &kp SPACE  &kp RET    &kp RALT
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &gresc    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp DEL
   &kp TAB  &none      &kp UP     &none      &kp UNDER  &kp MINUS      &kp PG_UP  &kp HOME   &kp INS    &kp UP     &kp DOWN   &none
   &kp LCTRL  &kp LEFT   &kp DOWN   &kp RIGHT  &kp PLUS   &kp EQUAL      &kp PG_DN  &kp END    &kp LS(INS) &kp LEFT  &kp RIGHT  &none
//                                  `--------------------------------'  `--------------------------------'
                                    &kp LGUI   &mo 3      &trans         &kp SPACE  &trans     &kp RALT
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &gresc    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5         &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp BSPC
   &kp LCTRL  &none      &none      &none      &none      &kp F11        &kp F12    &none      &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
   &kp LCTRL  &none      &none      &none      &none      &none          &none      &none      &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
//                                  `--------------------------------'  `--------------------------------'
                                    &kp LGUI   &sl 4      &mo 3          &kp RET    &trans     &kp RALT
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &bootloader &none     &none      &none      &none      &none          &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS &kp KP_DIVIDE &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none &none         &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS  &kp KP_MULTIPLY &none
   &out OUT_TOG &none    &none      &none      &none      &none          &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT   &kp COLON  &bootloader
//                                  `--------------------------------'  `--------------------------------'
                                    &kp LGUI   &trans     &kp SPACE      &kp SPACE  &kp KP_N0  &kp KP_ENTER
            >;
        };

        shifted_numbers_layer {
            display-name = "Shift Num";
            bindings = <
// ,-----------------------------------------------------.             ,-----------------------------------------------------.
   &trans     &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &trans
   &trans     &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans     &trans     &trans
   &trans     &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans     &trans     &trans
//                                  `--------------------------------'  `--------------------------------'
                                    &trans     &trans     &trans         &trans     &trans     &trans
            >;
        };

        // Empty layer for ZMK Studio to fill in. Ignored by non-Studio builds.
        extra1 { status = "reserved"; };
    };
};
